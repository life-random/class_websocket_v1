<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>채팅 (폴링)</title>
    <style>
        body {
            margin: 20px;
            font-family: Arial, sans-serif;
        }

        nav a {
            padding: 8px 15px;
            margin-right: 10px;
            background: #666;
            color: white;
            text-decoration: none;
        }

        .chat-area {
            border: 1px solid #ccc;
            height: 300px;
            padding: 10px;
            overflow-y: scroll;
            background: #f9f9f9;
        }

        .message {
            padding: 5px 10px;
            margin: 3px 0;
            background: white;
            border-radius: 8px;
            max-width: 80%;
        }

        form {
            margin-top: 10px;
            display: flex;
            gap: 10px;
        }

        input {
            flex: 1;
            padding: 8px;
        }

        button {
            padding: 8px 15px;
            background: #007bff;
            color: white;
            border: none;
        }
    </style>
</head>
<body>

<h3>채팅 (SSE)</h3>
<p id="status">서버에 연결하는 중 ......</p>

<div class="chat-area" id="chatArea">
    {{#chats}}
        <div class="message">{{msg}}</div>
    {{/chats}}
</div>

<form id="chatForm">
    <input type="text" name="msg" id="msg" placeholder="메세지 입력" required autofocus>
    <button type="submit">전송</button>
</form>

<script>
    const chatArea = document.getElementById('chatArea');
    const status = document.getElementById('status');
    const chatForm = document.getElementById('chatForm');
    const msgInput = document.getElementById('msg');

    // 받은 메세지를 화면 맨 아래에 추가한다.
    function appendMessage(msg){
        const div = document.createElement("div");
        div.className = "message";
        div.textContent = msg;
        chatArea.appendChild(div);

        chatArea.scrollTop = chatArea.scrollHeight;
    }

    // === 받기 : SSE ==

    // 1. 서버네 SSE 연결은 연다 (브라우저 내장 객체, 끊기면 자동으로 다시 연결한다)
     const eventSource = new EventSource('/sse/connect');

    // 2. 연력이 열리면 상태를 표시한다
    eventSource.onopen = () => {
        status.textContent = '서버와 연결됨(SSE): 새 메시지가 오면 바로 표시 됩니다.'
    }

    // 3. 서버가 chat 이벤트를 보내면 화면에 추가한다. (내가 보낸 메시지도 여기로 들어 온다)
    eventSource.addEventListener('chat', (event) => {
        appendMessage(event.data);
    })

    // 4. 연결이 끊기면 상태를 표시한다. (EventSource 가 알아서 재연결을 시도한다.
    eventSource.onerror = () => {
        status.textContent = '연결이 끊겼습니다. 다시 연결하는 중 ......'
    };

    // ======================= 데이터 보내기 : fetch 활용 =======================
    chatForm.addEventListener('submit', async (e) => {
       // 폼 기본 동작을 막는다
       e.preventDefault();

       const response = await fetch('/chat', {
           method: 'POST',
           body: new URLSearchParams({msg : msgInput.value})
       })

        if (!response.ok){
            alert("메시지 전송에 실패했습니다");
            return;
        }

        msgInput.value = ' ';
        msgInput.focus();
    });

    // 처음 그려진 메시지 중 최신 메시지가 보이도록 스크롤을 맨 아래로 내린다
    chatArea.scrollTop = chatArea.scrollHeight;

</script>
</body>
</html>